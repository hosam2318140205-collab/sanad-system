# ── Supabase → Project Settings → API ─────────────────────────────────────────
# Public (sent to the browser). Use the anon / publishable key ONLY.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server only — never prefix with NEXT_PUBLIC_. Used by the owner's "create staff" screen.
# The build fails if a secret key is ever placed in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-OR-SECRET-KEY
